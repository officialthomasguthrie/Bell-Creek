; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bell Creek"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameState="*uid://br2fthb12wvhg"
SaveSystem="*uid://bwdbg8e4p42ou"
SceneLoader="*uid://d314udmvo5vgy"
AudioManager="*uid://bq74qlsde4u2j"
Settings="*res://scripts/autoload/settings.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Bell Creek"

[editor_plugins]

enabled=PackedStringArray("res://addons/pixellab_stack_paint/plugin.cfg")

